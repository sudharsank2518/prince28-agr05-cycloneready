# Copy this file to .env and fill in real values. .env is never committed.
APP_NAME=cycloneready
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/combined_records.json
# Paste your Neon connection string here, in .env only (it contains your password).
# It starts with postgresql:// and ends with ?sslmode=require (Neon dashboard > Connect).
DATABASE_URL=postgresql://localhost:5432/cycloneready

# S3-compatible object storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1

# LLM providers
GEMINI_API_KEY=
GROQ_API_KEY=

# Primary and fallback models
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=llama-3.3-70b-versatile

# Provider URLs
LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1

# LLM settings
LLM_TIMEOUT_SECONDS=30
USD_TO_INR=88.0

# Prompt directory
PROMPTS_DIR=prompts
# Optional local Ollama fallback
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Background ingestion queue
REDIS_URL=redis://localhost:6379
ADMIN_TOKEN=
WORKER_IN_API=false

# Worker limits
INGEST_CONCURRENCY=1
INGEST_RPM=12.0
INGEST_JOB_TIMEOUT=600
INGEST_MAX_TRIES=3
