# Copy this file to .env and fill in real values. .env is never committed.
APP_NAME=cycloneready
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json
# Paste your Neon connection string here, in .env only (it contains your password).
# It starts with postgresql:// and ends with ?sslmode=require (Neon dashboard > Connect).
DATABASE_URL=postgresql://localhost:5432/cycloneready

# S3-compatible object storage
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_REGION=us-east-1
